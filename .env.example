# Copy to .env and fill in your Commercetools credentials.
# The dashboard's staging/production toggle picks which set is used.

# ── Production ─────────────────────────────────────────────────────────────
PROD_CTP_PROJECT_KEY=
PROD_CTP_CLIENT_ID=
PROD_CTP_CLIENT_SECRET=
PROD_CTP_AUTH_URL=
PROD_CTP_API_URL=
PROD_CTP_SCOPES=
# Base URL to prefix in front of each CTProductUrlComponent slug
PROD_CT_BASE_URL=https://

# ── Staging ────────────────────────────────────────────────────────────────
STG_CTP_PROJECT_KEY=
STG_CTP_CLIENT_ID=
STG_CTP_CLIENT_SECRET=
STG_CTP_AUTH_URL=
STG_CTP_API_URL=
STG_CTP_SCOPES=
STG_CT_BASE_URL=https://

# ── Audit tool config (optional overrides) ─────────────────────────────────
# PORT=7331
# CONCURRENCY=25
# VIDEOS_DIR=./videos

# ── Outbound proxy for Playwright (needed on Railway / AWS / DO / …) ───────
# Datacenter IPs get 403'd hard by Cloudflare. Route Playwright through a
# residential or allowlisted proxy so audits from cloud hosting look like
# a real client. Format: http[s]://[user:pass@]host:port
# Also honoured: HTTPS_PROXY, HTTP_PROXY.
# For credentials, either embed in the URL or set PROXY_USERNAME/PROXY_PASSWORD.
# PROXY_URL=http://user:pass@brd.superproxy.io:22225
# PROXY_USERNAME=
# PROXY_PASSWORD=
